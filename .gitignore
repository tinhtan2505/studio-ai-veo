# -----------------------------------------------------------------------------
# Canonical ignore rules for the Studio AI Gemini Omni repository.
# Frontend-only rules are also mirrored by apps/.gitignore.
# -----------------------------------------------------------------------------

# IntelliJ IDEA / JetBrains
/.idea/shelf/
/.idea/workspace.xml
/.idea/httpRequests/
/.idea/dataSources/
/.idea/dataSources.local.xml
**/.idea/
*.iws
*.iml
*.ipr

# Eclipse / Spring Tool Suite
**/.apt_generated/
**/.classpath
**/.factorypath
**/.project
**/.settings/
**/.springBeans
**/.sts4-cache/

# NetBeans
**/nbproject/private/
**/nbbuild/
**/nbdist/
**/.nb-gradle/

# Visual Studio Code
**/.vscode/

# Frontend / Next.js (also mirrored by the nested apps repository)
/apps/node_modules/
/apps/.pnp/
/apps/.pnp.*
/apps/.yarn/
/apps/coverage/
/apps/test-results/
/apps/playwright-report/
/apps/blob-report/
/apps/.next/
/apps/out/
/apps/build/
/apps/.vercel/
/apps/.env*
/apps/*.tsbuildinfo
/apps/next-env.d.ts

# Backend / Gradle / Java build output
/backend/HELP.md
/backend/.gradle/
/backend/build/
/backend/bin/
/backend/out/
/backend/data/
/backend/nbproject/private/
/backend/nbbuild/
/backend/dist/
/backend/nbdist/
/backend/src/main/resources/application.properties
!/backend/gradle/wrapper/gradle-wrapper.jar
!/backend/src/main/**/build/
!/backend/src/test/**/build/
!/backend/src/main/**/bin/
!/backend/src/test/**/bin/
!/backend/src/main/**/out/
!/backend/src/test/**/out/

# Environment / local configuration
.env
.env.*
!.env.example

# Logs and OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
*.pem
